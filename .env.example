# ============================================================
# Exemple de variables d'environnement — AUCUNE VALEUR RÉELLE
# Copier vers .env (non versionné) et renseigner localement.
# ============================================================

# --- Fournisseur IA par défaut (Web + benchmarks) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Fournisseurs IA alternatifs (optionnels) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Export Intervals.ICU (optionnel) ---
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
